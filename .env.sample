# Arbitrum Mainnet RPC URL for forking the blockchain
# Replace with your own provider if needed (e.g., Infura, Alchemy)
ARBITRUM_MAINNET_RPC_URL="https://arb1.arbitrum.io/rpc"

# Block number to fork from. Use a recent block for up-to-date data.
# You can find a recent block number on a block explorer like Arbiscan.
# Example: FORK_BLOCK_NUMBER=140000000
FORK_BLOCK_NUMBER=

# Go Gin web framework mode
# Set to "debug" for development to get more detailed logging,
# or "release" for production environments.
GIN_MODE=debug

# Address of the deployed UniswapVersionChecker contract (if used by the bot)
# This may not be necessary depending on the bot's features.
UNISWAP_VERSION_CHECKER_ADDRESS=
